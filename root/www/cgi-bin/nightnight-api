#!/usr/bin/ucode
// NightNight 0.6.0 - CGI REST API & MCP JSON-RPC Server

import * as fs from "fs";

const LIVE_FILE = "/tmp/nightnight/live.json";
const HIST_TMP_FILE = "/tmp/nightnight/history.json";
const HIST_ETC_FILE = "/etc/nightnight/history.json";
const DEVICES_ETC_FILE = "/etc/nightnight/devices.json";

function load_json(path) {
	let raw = fs.readfile(path);
	if (!raw) return null;
	let data = null;
	try {
		data = json(raw);
	} catch (e) {
		data = null;
	}
	return data;
}

function save_json(path, data) {
	let tmp = path + ".tmp";
	fs.writefile(tmp, sprintf("%J", data));
	fs.rename(tmp, path);
}

function urldecode(s) {
	if (!s) return "";
	s = replace(s, /\+/g, " ");
	return replace(s, /%([0-9a-fA-F]{2})/g, function(m, hex) {
		return chr(int(hex, 16));
	});
}

function parse_query(qs) {
	let params = {};
	if (!qs) return params;
	for (let pair in split(qs, "&")) {
		let kv = split(pair, "=", 2);
		if (length(kv) == 2) {
			params[urldecode(kv[0])] = urldecode(kv[1]);
		} else if (length(kv) == 1 && kv[0] != "") {
			params[urldecode(kv[0])] = "";
		}
	}
	return params;
}

function fmt_bytes(b) {
	b = int(b || 0);
	if (b <= 0) return "0 B";
	if (b < 1024) return b + " B";
	if (b < 1024 * 1024) {
		let kb = b / 1024.0;
		return (kb >= 100 ? sprintf("%d KB", int(kb + 0.5)) : sprintf("%.1f KB", kb));
	}
	if (b < 1024 * 1024 * 1024) {
		let mb = b / (1024.0 * 1024.0);
		return (mb >= 100 ? sprintf("%d MB", int(mb + 0.5)) : sprintf("%.1f MB", mb));
	}
	let gb = b / (1024.0 * 1024.0 * 1024.0);
	return sprintf("%.2f GB", gb);
}

function evaluate_heuristics(h_entry) {
	let h = lc(h_entry.host || "");
	let tags = [];
	let notes = [];
	let score = 0;
	let reasons = [];

	if (index(h, ".cos.") >= 0 || index(h, ".myqcloud.com") >= 0 || index(h, ".aliyuncs.com") >= 0 ||
	    index(h, ".s3.") >= 0 || index(h, "amazonaws.com") >= 0 || index(h, "r2.cloudflarestorage.com") >= 0) {
		push(tags, { text: "共用云存储", type: "neutral" });
		let bucket = split(h, ".")[0] || h;
		if (index(h, "myqcloud.com") >= 0) {
			push(notes, "腾讯云对象存储 (COS)：很多公司共用的主机名。从名字只能知道是哪家的存储服务，不知道数据是谁的。桶名“" + bucket + "”只能当作线索。");
		} else if (index(h, "aliyuncs.com") >= 0) {
			push(notes, "阿里云对象存储 (OSS)：很多公司共用的主机名。从名字只能知道是哪家的存储服务，不知道数据是谁的。桶名“" + bucket + "”只能当作线索。");
		} else {
			push(notes, "公有云对象存储服务：多个应用共用的存储域名，桶名“" + bucket + "”只能当作线索。");
		}
	}

	if (index(h, "wxkb") >= 0 || substr(h, 0, 4) == "ime." || index(h, ".ime.") >= 0 || index(h, "-ime") >= 0 || index(h, "input") >= 0 || index(h, "sogou") >= 0 || index(h, "iflytek") >= 0) {
		push(tags, { text: "名字像输入法", type: "warn" });
		score += 45;
		push(reasons, "名字像输入法");
		if (index(h, "wxkb") >= 0) {
			push(notes, "名字里有“wxkb”，看起来像输入法或键盘相关的服务。这只是根据名字猜的。");
		} else {
			push(notes, "名字里有输入法相关特征词，看起来像输入法或键盘相关的服务。这只是根据名字猜的。");
		}
	}

	if (h_entry.encrypted === false) {
		push(tags, { text: "未加密", type: "warn" });
		score += 35;
		push(reasons, "未加密传输");
		push(notes, "检测到该主机存在未加密（HTTP 或明文端口）传输行为，数据内容在网络链路中缺乏 TLS 保护。");
	}

	if (index(h, "metrics") >= 0 || index(h, "telemetry") >= 0 || index(h, "beacon") >= 0 || index(h, "collect") >= 0 ||
	    index(h, "nel.") >= 0 || index(h, "user-data") >= 0 || index(h, "log") >= 0) {
		push(tags, { text: "遥测或日志", type: "info" });
		score += 15;
		push(reasons, "遥测或数据上报域名");
		push(notes, "名字包含遥测/数据统计特征（如 metrics / user-data / nel），通常用于客户端后台上报行为或诊断日志。");
	}

	if ((h_entry.max_single_up || 0) >= 5 * 1024 * 1024 || (h_entry.up || 0) >= 10 * 1024 * 1024) {
		score += 50;
		push(reasons, "单次或累计大额上传 (" + fmt_bytes(h_entry.max_single_up || h_entry.up) + ")");
	} else if ((h_entry.up || 0) >= 1024 * 1024 && (h_entry.up || 0) > (h_entry.down || 1) * 3) {
		score += 30;
		push(reasons, "上传量显著高于下载量");
	}

	if ((h_entry.night_up || 0) >= 100 * 1024) {
		score += 25;
		push(reasons, "存在夜间上传 (" + fmt_bytes(h_entry.night_up) + ")");
	}

	unshift(notes, "路由器上的名单里没有这个网站的说明。");

	return { tags, notes, score, reasons };
}

function compute_active_duration(active_hours_map) {
	let hours = keys(active_hours_map || {});
	let hour_count = length(hours);
	if (hour_count == 0) hour_count = 1;
	let days_map = {};
	for (let h in hours) {
		let d = substr(h, 0, 10);
		days_map[d] = true;
	}
	let day_count = length(keys(days_map));
	if (day_count == 0) day_count = 1;
	return {
		days: day_count,
		hours: hour_count,
		label: day_count + " 天 · " + hour_count + " 小时"
	};
}

function get_devices_map(live, custom_devs) {
	let m = {};
	if (type(custom_devs) == "object") {
		for (let ip, d in custom_devs) m[ip] = d.name || ip;
	}
	if (live && type(live.devices) == "array") {
		for (let d in live.devices) m[d.ip] = d.name || d.ip;
	}
	return m;
}

function build_host_item(h_entry, dev_names_map, filter_dev) {
	let up = h_entry.up || 0;
	let down = h_entry.down || 0;
	let conn_count = h_entry.conn_count || 1;
	let max_single_up = h_entry.max_single_up || up;
	let night_up = h_entry.night_up || 0;
	let idle_up = h_entry.idle_up || 0;

	let devs = h_entry.devices || {};
	let dev_ips = keys(devs);
	if (filter_dev && filter_dev != "all" && filter_dev != "") {
		let dstat = devs[filter_dev];
		if (!dstat) return null;
		up = dstat.up || 0;
		down = dstat.down || 0;
		conn_count = dstat.conn_count || 1;
		max_single_up = dstat.max_single_up || up;
		night_up = dstat.night_up || 0;
	}

	let dev_count = length(dev_ips);
	let dev_label = "";
	if (dev_count == 1) {
		let only_ip = dev_ips[0];
		dev_label = dev_names_map[only_ip] || only_ip;
	} else if (dev_count > 1) {
		dev_label = dev_count + " 台设备在用";
	} else {
		dev_label = "1 台设备在用";
	}

	let dur = compute_active_duration(h_entry.active_hours);
	let heur = evaluate_heuristics(h_entry);

	return {
		host: h_entry.host,
		group_id: h_entry.group_id || "unknown",
		provider: h_entry.provider || "Direct / CDN",
		up: up,
		down: down,
		conn_count: conn_count,
		max_single_up: max_single_up,
		night_up: night_up,
		idle_up: idle_up,
		encrypted: (h_entry.encrypted !== false),
		dpi_app: h_entry.dpi_app || "",
		dpi_proto: h_entry.dpi_proto || "TLS",
		device_count: dev_count || 1,
		device_label: dev_label,
		devices: devs,
		active_days: dur.days,
		active_hours: dur.hours,
		active_label: dur.label,
		tags: heur.tags,
		notes: heur.notes,
		suspicious_score: heur.score,
		suspicious_reasons: heur.reasons
	};
}

function build_inspect_response(host_query, device_filter, days_filter, hist, live, custom_devs) {
	let dev_names = get_devices_map(live, custom_devs);
	let hosts = (hist && hist.hosts) ? hist.hosts : {};
	let target = hosts[host_query];

	// Fuzzy match if exact host not found
	if (!target && host_query) {
		let lq = lc(host_query);
		let best_up = -1;
		for (let k, v in hosts) {
			if (index(lc(k), lq) >= 0 && (v.up || 0) > best_up) {
				target = v;
				best_up = v.up || 0;
			}
		}
	}

	if (!target) {
		return {
			found: false,
			query: host_query
		};
	}

	let total_all_up = 0;
	for (let k, v in hosts) {
		total_all_up += (v.up || 0);
	}
	if (total_all_up <= 0) total_all_up = 1;

	let item = build_host_item(target, dev_names, device_filter);
	if (!item) {
		item = build_host_item(target, dev_names, "all");
	}

	let up_share_pct = int((item.up * 100.0) / total_all_up + 0.5);
	if (up_share_pct < 1 && item.up > 0) up_share_pct = 1;
	let ratio_str = "";
	if (item.up >= item.down && item.down > 0) {
		let r = int((item.up * 1.0) / item.down + 0.5);
		if (r < 1) r = 1;
		ratio_str = "上传/下载 " + r + "×";
	} else if (item.down > item.up && item.up > 0) {
		let r = int((item.down * 1.0) / item.up + 0.5);
		ratio_str = "下载/上传 " + r + "×";
	} else {
		ratio_str = "主要为单向传输";
	}

	let avg_conn_up = item.conn_count > 0 ? int(item.up / item.conn_count) : item.up;
	let night_pct = item.up > 0 ? int((item.night_up * 100.0) / item.up + 0.5) : 0;
	let idle_pct = item.up > 0 ? int((item.idle_up * 100.0) / item.up + 0.5) : 0;

	// Synthesize "它在干什么？" natural language analysis matching Screenshot 3
	let big_hours_map = target.big_hours || {};
	let big_hours_count = length(keys(big_hours_map));
	let big_hours_up = 0;
	for (let hk, hv in big_hours_map) big_hours_up += hv;
	if (big_hours_count == 0 && item.max_single_up >= 1024 * 1024) {
		big_hours_count = item.active_hours;
		big_hours_up = item.up;
	}
	let big_share_pct = item.up > 0 ? int((big_hours_up * 100.0) / item.up + 0.5) : 100;
	if (big_share_pct > 100) big_share_pct = 100;

	let behavior_summary = "";
	if (item.max_single_up >= 1024 * 1024) {
		behavior_summary = sprintf(
			"少数几次大的上传：有 %d 个小时里，单条连接传了超过 1 MB；这些小时一共上传 %s，占这里全部上传的 %d%%。传文件、照片、视频或做备份通常是这个样子。",
			big_hours_count || 1,
			fmt_bytes(big_hours_up > 0 ? big_hours_up : item.up),
			big_share_pct
		);
	} else if (item.conn_count >= 20 && avg_conn_up < 100 * 1024) {
		behavior_summary = sprintf(
			"高频小数据包通信：累计建立了 %d 条连接，平均每次连接仅上传 %s（最大单条 %s）。后台心跳、遥测上报、输入法云联想或消息同步通常是这个样子。",
			item.conn_count,
			fmt_bytes(avg_conn_up),
			fmt_bytes(item.max_single_up)
		);
	} else if (item.down > item.up * 3) {
		behavior_summary = sprintf(
			"以下载拉取内容为主：累计下载 %s，而上传仅 %s（共 %d 条连接）。正常浏览网页、拉取静态资源、软件更新或流媒体播放通常是这个样子。",
			fmt_bytes(item.down),
			fmt_bytes(item.up),
			item.conn_count
		);
	} else {
		behavior_summary = sprintf(
			"常规双向数据交互：在 %d 个活跃小时内建立了 %d 条连接，累计上传 %s、下载 %s，单条连接最大上传 %s。",
			item.active_hours,
			item.conn_count,
			fmt_bytes(item.up),
			fmt_bytes(item.down),
			fmt_bytes(item.max_single_up)
		);
	}

	let dev_breakdown = [];
	for (let dip, dstat in (target.devices || {})) {
		push(dev_breakdown, {
			ip: dip,
			name: dev_names[dip] || dip,
			up: dstat.up || 0,
			down: dstat.down || 0,
			conn_count: dstat.conn_count || 1,
			max_single_up: dstat.max_single_up || 0
		});
	}
	sort(dev_breakdown, function(a, b) { return b.up - a.up; });

	return {
		found: true,
		host: item.host,
		group_id: item.group_id,
		provider: item.provider,
		tags: item.tags,
		up: item.up,
		down: item.down,
		up_share_pct: up_share_pct,
		ratio_str: ratio_str,
		conn_count: item.conn_count,
		avg_conn_up: avg_conn_up,
		max_single_up: item.max_single_up,
		active_days: item.active_days,
		active_hours: item.active_hours,
		night_up: item.night_up,
		night_pct: night_pct,
		idle_up: item.idle_up,
		idle_pct: idle_pct,
		behavior_summary: behavior_summary,
		notes: item.notes,
		devices: dev_breakdown
	};
}

