// Handle HTTP request
let method = getenv("REQUEST_METHOD") || "GET";
let qs = getenv("QUERY_STRING") || "";
let params = parse_query(qs);
let action = params.action || "overview";

let live = load_json(LIVE_FILE) || {
	version: "0.6.0",
	ui_version: "0.6.0-1",
	router: { up_bps: 0, down_bps: 0, active_devices: 0, total_devices: 0, active_groups: 0, total_groups: 0, today_up: 0, today_down: 0, total_connections: 0, status_text: "正在初始化..." },
	alerts: [],
	devices: [],
	groups: [],
	connections: []
};
let hist = load_json(HIST_TMP_FILE) || load_json(HIST_ETC_FILE) || { hosts: {} };
let custom_devs = load_json(DEVICES_ETC_FILE) || {};
let dev_names = get_devices_map(live, custom_devs);

print("Content-Type: application/json; charset=utf-8\r\n");
print("Access-Control-Allow-Origin: *\r\n");
print("Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n");
print("Access-Control-Allow-Headers: Content-Type\r\n");
print("Cache-Control: no-store\r\n\r\n");

if (method == "OPTIONS") {
	print("{}\n");
	exit(0);
}

// Support MCP JSON-RPC 2.0 over HTTP POST
if (method == "POST" && (action == "mcp" || action == "overview")) {
	let body = fs.readfile("/dev/stdin");
	let rpc = null;
	try {
		rpc = json(body);
	} catch (e) {
		rpc = null;
	}
	if (rpc && rpc.jsonrpc == "2.0") {
		let id = rpc.id;
		let m = rpc.method || "";
		let p = rpc.params || {};

		if (m == "initialize") {
			print(sprintf("%J\n", {
				jsonrpc: "2.0",
				id: id,
				result: {
					protocolVersion: "2024-11-05",
					capabilities: { tools: {} },
					serverInfo: { name: "nightnight-openwrt-mcp", version: "0.6.0" }
				}
			}));
			exit(0);
		}
		if (m == "notifications/initialized") {
			print(sprintf("%J\n", { jsonrpc: "2.0", id: id, result: {} }));
			exit(0);
		}
		if (m == "tools/list") {
			print(sprintf("%J\n", {
				jsonrpc: "2.0",
				id: id,
				result: {
					tools: [
						{
							name: "nightnight_overview",
							description: "获取 OpenWrt 路由器实时流量拓扑概览、在用设备、去向分类及异常告警",
							inputSchema: { type: "object", properties: {} }
						},
						{
							name: "nightnight_suspicious_uploads",
							description: "查询路由器审计发现的可疑上传行为（如大额单条连接上传、输入法/云存储可疑上传、夜间静默上传、未加密明文传输等）",
							inputSchema: {
								type: "object",
								properties: {
									min_score: { type: "number", description: "最低可疑评分阈值，默认 15" }
								}
							}
						},
						{
							name: "nightnight_inspect_host",
							description: "查网站：深入分析某个主机名/域名的历史流量特征（上传/下载、最大单次连接、夜间上传、活跃小时数及自然语言行为画像“它在干什么？”）",
							inputSchema: {
								type: "object",
								properties: {
									host: { type: "string", description: "要查询的域名或主机名关键字，例如 wxkb 或 googleapis.com" },
									device: { type: "string", description: "可选设备 IP 过滤，默认 all" }
								},
								required: ["host"]
							}
						},
						{
							name: "nightnight_group_hosts",
							description: "列出某个去向分类（如 wechat, tencent, google, openai, alibaba, apple, unknown 或 all）下的所有主机名明细，按上传流量降序排列",
							inputSchema: {
								type: "object",
								properties: {
									group_id: { type: "string", description: "去向分类 ID（如 wechat, tencent, google, openai, all）" }
								}
							}
						}
					]
				}
			}));
			exit(0);
		}
		if (m == "tools/call") {
			let tname = p.name || "";
			let targs = p.arguments || {};
			let result_data = {};

			if (tname == "nightnight_overview") {
				result_data = {
					router: live.router,
					alerts: live.alerts,
					devices: live.devices,
					groups: live.groups
				};
			} else if (tname == "nightnight_suspicious_uploads") {
				let min_sc = int(targs.min_score || 15);
				let list = [];
				for (let hk, hv in (hist.hosts || {})) {
					let item = build_host_item(hv, dev_names, "all");
					if (item && (item.suspicious_score >= min_sc || item.up >= 1024 * 1024)) {
						push(list, item);
					}
				}
				sort(list, function(a, b) { return (b.suspicious_score - a.suspicious_score) || (b.up - a.up); });
				result_data = { count: length(list), suspicious_hosts: slice(list, 0, 30) };
			} else if (tname == "nightnight_inspect_host") {
				result_data = build_inspect_response(targs.host || "", targs.device || "all", 7, hist, live, custom_devs);
			} else if (tname == "nightnight_group_hosts") {
				let gid = targs.group_id || "all";
				let list = [];
				for (let hk, hv in (hist.hosts || {})) {
					if (gid != "all" && hv.group_id != gid) continue;
					let item = build_host_item(hv, dev_names, "all");
					if (item) push(list, item);
				}
				sort(list, function(a, b) { return b.up - a.up; });
				result_data = { group_id: gid, count: length(list), hosts: slice(list, 0, 50) };
			} else {
				result_data = { error: "Unknown tool: " + tname };
			}

			print(sprintf("%J\n", {
				jsonrpc: "2.0",
				id: id,
				result: {
					content: [
						{ type: "text", text: sprintf("%J", result_data) }
					]
				}
			}));
			exit(0);
		}
	}
}

