if (action == "hosts" || action == "group") {
	let gid = params.id || params.group || "all";
	let dev_filter = params.device || "all";
	let q = lc(params.q || "");
	let list = [];
	for (let hk, hv in (hist.hosts || {})) {
		if (gid != "all" && hv.group_id != gid) continue;
		if (q != "" && index(lc(hk), q) < 0) continue;
		let item = build_host_item(hv, dev_names, dev_filter);
		if (item) push(list, item);
	}
	sort(list, function(a, b) {
		return (b.up - a.up) || (b.down - a.down);
	});
	print(sprintf("%J\n", {
		group_id: gid,
		device: dev_filter,
		total: length(list),
		hosts: slice(list, 0, 100),
		devices_list: live.devices || []
	}));
	exit(0);
}

