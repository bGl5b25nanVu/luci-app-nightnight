#!/bin/sh /etc/rc.common
# NightNight 0.6.0 init script

START=96
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /tmp/nightnight /etc/nightnight
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/nightnightd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -f /tmp/nightnight/history.json ] && cp -f /tmp/nightnight/history.json /etc/nightnight/history.json 2>/dev/null
}
