#!/usr/bin/ucode
// NightNight 0.6.0 - OpenWrt DPI & Privacy Traffic Audit Daemon
// Combines netifyd DPI stream + mihomo connections API + nf_conntrack + DHCP leases

import * as uloop from "uloop";
import * as socket from "socket";
import * as fs from "fs";

const VERSION = "0.6.0";
const TMP_DIR = "/tmp/nightnight";
const ETC_DIR = "/etc/nightnight";
const LIVE_FILE = TMP_DIR + "/live.json";
const HIST_TMP_FILE = TMP_DIR + "/history.json";
const HIST_ETC_FILE = ETC_DIR + "/history.json";
const DEVICES_ETC_FILE = ETC_DIR + "/devices.json";
const NETIFY_SOCK = "/var/run/netifyd/netifyd.sock";

// Auto-detect LAN subnet prefix (e.g. "192.168.8.") and router IP from /etc/config/network
let LAN_PREFIX = "192.168.8.";
let ROUTER_IP = "192.168.8.1";
let net_cfg = fs.readfile("/etc/config/network") || "";
let m_lan = match(net_cfg, /config interface 'lan'[\s\S]*?option ipaddr '([0-9]+\.[0-9]+\.[0-9]+)\.([0-9]+)'/);
if (m_lan) {
	LAN_PREFIX = m_lan[1] + ".";
	ROUTER_IP = m_lan[1] + "." + m_lan[2];
}

fs.mkdir(TMP_DIR);
fs.mkdir(ETC_DIR);

// State structures
let custom_devices = {};
let dhcp_devices = {}; // ip -> { mac, name, icon }
let mac_to_ip = {};

// Active connection tracking: conn_id -> { src_ip, dst_host, dst_ip, dst_port, proto, up, down, start_ts, encrypted, dpi_app, dpi_proto }
let prev_conns = {};
// Recent DPI flow metadata from netifyd: key -> { host, app, proto, encrypted, risks, subject_dn, ts }
let dpi_flows = {};
// Learned IP -> Hostname mapping from mihomo DNS/sniff & netifyd TLS certificates
let ip_to_domain = {};
let subnet24_to_group = {};
let netify_connected = false;
let netify_flow_count = 0;

// Persistent history structure
let history = {
	version: VERSION,
	started_at: time(),
	today_date: "",
	today_up: 0,
	today_down: 0,
	hosts: {} // host -> { host, group_id, up, down, conn_count, max_single_up, night_up, idle_up, encrypted, dpi_app, dpi_proto, first_seen, last_seen, active_hours: {}, big_hours: {}, devices: {} }
};

function load_json_file(path) {
	let content = fs.readfile(path);
	if (!content) return null;
	let parsed = null;
	try {
		parsed = json(content);
	} catch (e) {
		parsed = null;
	}
	return parsed;
}

function save_json_file(path, data) {
	let tmp = path + ".tmp";
	fs.writefile(tmp, sprintf("%J", data));
	fs.rename(tmp, path);
}

// Load saved custom devices & history
let saved_devs = load_json_file(DEVICES_ETC_FILE);
if (type(saved_devs) == "object") {
	custom_devices = saved_devs;
} else {
	// Default known LAN devices on this router
	custom_devices = {
		"192.168.8.245": { name: "MacBook-Pro", icon: "laptop" },
		"192.168.8.208": { name: "HOP-AL00", icon: "phone" },
		"192.168.8.194": { name: "Mac", icon: "laptop" },
		"192.168.8.215": { name: "iMac", icon: "laptop" }
	};
	save_json_file(DEVICES_ETC_FILE, custom_devices);
}

let saved_hist = load_json_file(HIST_TMP_FILE) || load_json_file(HIST_ETC_FILE);
if (type(saved_hist) == "object" && type(saved_hist.hosts) == "object") {
	history = saved_hist;
}

function get_date_parts(ts) {
	let lt = localtime(ts || time());
	let date_str = sprintf("%04d-%02d-%02d", lt.year, lt.mon, lt.mday);
	let hour_str = sprintf("%04d-%02d-%02d-%02d", lt.year, lt.mon, lt.mday, lt.hour);
	let is_night = (lt.hour >= 0 && lt.hour < 6);
	return { date_str, hour_str, is_night, hour: lt.hour };
}

// Refresh DHCP leases and ARP table
function refresh_devices() {
	let leases = fs.readfile("/tmp/dhcp.leases");
	if (leases) {
		for (let line in split(leases, "\n")) {
			let parts = split(trim(line), /\s+/);
			if (length(parts) >= 4) {
				let mac = lc(parts[1]);
				let ip = parts[2];
				let name = parts[3];
				mac_to_ip[mac] = ip;
				let last_octet = split(ip, ".")[3] || "0";
				if (!name || name == "*") {
					name = (custom_devices[ip] && custom_devices[ip].name) ? custom_devices[ip].name : ("未命名设备 #" + last_octet);
				}
				let icon = "phone";
				let ln = lc(name);
				if (index(ln, "mac") >= 0 || index(ln, "pc") >= 0 || index(ln, "desktop") >= 0 || index(ln, "laptop") >= 0 || index(ln, "win") >= 0) {
					icon = "laptop";
				}
				if (custom_devices[ip] && custom_devices[ip].icon) icon = custom_devices[ip].icon;
				if (custom_devices[ip] && custom_devices[ip].name) name = custom_devices[ip].name;
				dhcp_devices[ip] = { ip, mac, name, icon };
			}
		}
	}
	let arp = fs.readfile("/proc/net/arp");
	if (arp) {
		let lines = split(arp, "\n");
		for (let i = 1; i < length(lines); i++) {
			let parts = split(trim(lines[i]), /\s+/);
			if (length(parts) >= 6 && substr(parts[0], 0, 10) == "192.168.8.") {
				let ip = parts[0];
				let mac = lc(parts[3]);
				mac_to_ip[mac] = ip;
				if (!dhcp_devices[ip]) {
					let last_octet = split(ip, ".")[3] || "0";
					let name = (custom_devices[ip] && custom_devices[ip].name) ? custom_devices[ip].name : ("未命名设备 #" + last_octet);
					let icon = (custom_devices[ip] && custom_devices[ip].icon) ? custom_devices[ip].icon : "phone";
					dhcp_devices[ip] = { ip, mac, name, icon };
				}
			}
		}
	}
}

function get_device_info(ip) {
	if (!ip || ip == "127.0.0.1" || ip == "198.18.0.1" || ip == ROUTER_IP || substr(ip, 0, 8) == "100.100." || substr(ip, 0, 7) == "172.20." || substr(ip, 0, 8) == "172.254.") {
		return null; // Router internal / WAN / overlay self-traffic
	}
	if (dhcp_devices[ip]) return dhcp_devices[ip];
	if (substr(ip, 0, length(LAN_PREFIX)) == LAN_PREFIX) {
		let last_octet = split(ip, ".")[3] || "0";
		let name = (custom_devices[ip] && custom_devices[ip].name) ? custom_devices[ip].name : ("未命名设备 #" + last_octet);
		let icon = (custom_devices[ip] && custom_devices[ip].icon) ? custom_devices[ip].icon : "phone";
		dhcp_devices[ip] = { ip, mac: "", name, icon };
		return dhcp_devices[ip];
	}
	return null;
}

