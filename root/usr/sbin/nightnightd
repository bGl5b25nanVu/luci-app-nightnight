	"apple":      { id: "apple",      name: "Apple 服务",   badge: "A",  order: 5 },
	"cloudflare": { id: "cloudflare", name: "Cloudflare",   badge: "C",  order: 6 },
	"openai":     { id: "openai",     name: "AI 服务",      badge: "AI", order: 7 },
	"google":     { id: "google",     name: "Google",       badge: "G",  order: 8 },
	"alibaba":    { id: "alibaba",    name: "Alibaba",      badge: "阿", order: 9 },
	"jd":         { id: "jd",         name: "京东 JD",      badge: "京", order: 10 },
	"cmschina":   { id: "cmschina",   name: "招商证券/行情", badge: "招", order: 11 },
	"huawei":     { id: "huawei",     name: "华为云服务",   badge: "华", order: 12 },
	"sogou":      { id: "sogou",      name: "搜狗/输入法",  badge: "搜", order: 13 },
	"github":     { id: "github",     name: "GitHub / CDN", badge: "GH", order: 14 },
	"twitter":    { id: "twitter",    name: "X / Twitter",  badge: "X",  order: 15 },
	"unknown":    { id: "unknown",    name: "未识别",       badge: "?",  order: 99 }
};

// Detect proxy/tunnel server IPs from /etc/mihomo/config.yaml so router tunnel traffic is not confused with unknown LAN destinations
let proxy_server_ips = {
	"168.138.193.11": true,
	"168.138.203.133": true,
	"47.243.17.211": true,
	"100.100.2.15": true
};
let mh_cfg = fs.readfile("/etc/mihomo/config.yaml") || "";
for (let line in split(mh_cfg, "\n")) {
	let m = match(line, /server:\s*([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)/);
	if (m) proxy_server_ips[m[1]] = true;
}

function get_subnet24(ip) {
	if (!ip) return "";
	let p = split(ip, ".");
	if (length(p) != 4) return "";
	return p[0] + "." + p[1] + "." + p[2] + ".";
}

function learn_ip_domain(ip, domain, gid) {
	if (!ip || !domain || ip == domain) return;
	if (substr(ip, 0, 7) == "198.18." || substr(ip, 0, 8) == "127.0.0." || proxy_server_ips[ip]) return;
	// Only learn if domain is not a raw IP
	if (!match(domain, /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/)) {
		ip_to_domain[ip] = domain;
		let s24 = get_subnet24(ip);
		if (s24 != "" && gid && gid != "unknown") {
			subnet24_to_group[s24] = { group_id: gid, sample_domain: domain };
		}
	}
}

function classify_host(host, dpi_app, dst_port) {
	let h = lc(host || "");
	let app = lc(dpi_app || "");
	let port = int(dst_port || 0);

	// 1. WeChat (including wxkb-*, weixin.com, qpic.cn, qlogo.cn, and WeChat direct IP ranges)
	if (index(h, "weixin.qq.com") >= 0 || index(h, "weixin.com") >= 0 || index(h, "wechat.com") >= 0 ||
	    index(h, "wx.qq.com") >= 0 || index(h, "wxkb-") >= 0 || index(h, "tenpay.com") >= 0 ||
	    index(h, "servicewechat.com") >= 0 || index(h, "qlogo.cn") >= 0 || index(h, "qpic.cn") >= 0 ||
	    index(app, "wechat") >= 0 || index(app, "weixin") >= 0 ||
	    substr(h, 0, 11) == "119.147.19." || substr(h, 0, 8) == "157.148." || substr(h, 0, 8) == "157.255." || substr(h, 0, 7) == "183.60.") {
		return "wechat";
	}

	// 2. Sogou / Input Method / Baidu
	if (index(h, "sogou.com") >= 0 || index(h, "sogo.com") >= 0 || index(h, "iflytek.com") >= 0 ||
	    index(h, "baiduinput") >= 0 || index(h, "baidu.com") >= 0 || index(app, "baidu") >= 0) {
		return "sogou";
	}

	// 3. Tencent
	if (index(h, "myqcloud.com") >= 0 || index(h, "qq.com") >= 0 || index(h, "gtimg.com") >= 0 ||
	    index(h, "tencent.com") >= 0 || index(h, "qcloud.com") >= 0 || index(h, "doh.pub") >= 0 ||
	    h == "120.53.53.53" || h == "1.12.12.12" || substr(h, 0, 7) == "14.153." ||
	    substr(h, 0, 7) == "58.251." || substr(h, 0, 7) == "43.140." ||
	    index(app, "tencent") >= 0 || index(app, "qq") >= 0) {
		return "tencent";
	}

	// 4. Lark & Feishu / ByteDance
	if (index(h, "larksuite.com") >= 0 || index(h, "larkoffice.com") >= 0) {
		return "lark";
	}
	if (index(h, "feishu.cn") >= 0 || index(h, "feishucdn.com") >= 0 || index(h, "bytedance.com") >= 0 ||
	    index(h, "byteimg.com") >= 0 || index(h, "snssdk.com") >= 0 || index(h, "douyin.com") >= 0 ||
	    index(h, "doubao.com") >= 0 || index(h, "volces.com") >= 0 || index(h, "zijieapi.com") >= 0 ||
	    index(h, "tiktokv.com") >= 0 || index(h, "tiktokcdn.com") >= 0 || index(h, "byteeffect") >= 0 ||
	    index(app, "tiktok") >= 0 || index(app, "bytedance") >= 0) {
		return "feishu";
	}

	// 5. Apple
	if (index(h, "apple.com") >= 0 || index(h, "icloud.com") >= 0 || index(h, "mzstatic.com") >= 0 ||
	    index(h, "cdn-apple.com") >= 0 || index(h, "aaplimg.com") >= 0 ||
	    index(app, "apple") >= 0 || index(app, "icloud") >= 0) {
		return "apple";
	}

	// 6. Cloudflare & NTP
	if (index(h, "cloudflare.com") >= 0 || index(h, "cloudflare-dns.com") >= 0 ||
	    h == "1.1.1.1" || h == "1.0.0.1" || substr(h, 0, 12) == "162.159.200." ||
	    index(app, "cloudflare") >= 0) {
		return "cloudflare";
	}

	// 7. AI Services (OpenAI, DeepSeek, Grok, OpenRouter, Claude, OpenCode, Raycast, etc.)
	if (index(h, "chatgpt.com") >= 0 || index(h, "openai.com") >= 0 || index(h, "oaistatic.com") >= 0 ||
	    index(h, "oaiusercontent.com") >= 0 || index(h, "openrouter.ai") >= 0 || index(h, "deepseek.com") >= 0 ||
	    index(h, "grok.com") >= 0 || index(h, "anthropic.com") >= 0 || index(h, "claude.ai") >= 0 ||
	    index(h, "opencode.ai") >= 0 || index(h, "muse.ai") >= 0 || index(h, "workbuddy.ai") >= 0 ||
	    index(h, "agentbell.app") >= 0 || index(h, "metaaivm.com") >= 0 || index(h, "meta.ai") >= 0 || index(h, "usemagpie.ai") >= 0 ||
	    index(h, "raycast.com") >= 0 || index(h, "ray.so") >= 0 ||
	    substr(h, 0, 7) == "20.213." || substr(h, 0, 8) == "172.207." || substr(h, 0, 6) == "4.217.") {
		return "openai";
	}

	// 8. Google / Android
	if (index(h, "google.com") >= 0 || index(h, "googleapis.com") >= 0 || index(h, "gstatic.com") >= 0 ||
	    index(h, "googleusercontent.com") >= 0 || index(h, "youtube.com") >= 0 || index(h, "android.com") >= 0 ||
	    substr(h, 0, 11) == "216.239.35." || substr(h, 0, 7) == "34.102." ||
	    index(app, "google") >= 0 || index(app, "youtube") >= 0) {
		return "google";
	}

	// 9. Alibaba / Taobao / DingTalk / Quark
	if (index(h, "alibaba.com") >= 0 || index(h, "alicdn.com") >= 0 || index(h, "aliyuncs.com") >= 0 ||
	    index(h, "taobao.com") >= 0 || index(h, "goofish.com") >= 0 || index(h, "alipay.com") >= 0 ||
	    index(h, "mmstat.com") >= 0 || index(h, "dingtalk.com") >= 0 || index(h, "quark.cn") >= 0 ||
	    index(h, "npmmirror.com") >= 0 || index(h, "alidns.com") >= 0 || h == "223.5.5.5" || h == "223.6.6.6") {
		return "alibaba";
	}

	// 10. JD.com / Vipshop (京东 / 电商)
	if (index(h, "jd.com") >= 0 || index(h, "360buyimg.com") >= 0 || index(h, "300hu.com") >= 0 ||
	    index(h, "jdcloud.com") >= 0 || index(h, "jdcloud-oss.com") >= 0 || index(h, "jcloud.com") >= 0 ||
	    index(h, "vip.com") >= 0) {
		return "jd";
	}

	// 11. China Merchants Securities & Securities Trading (招商证券 / 富途 / 行情服务)
	if (index(h, "cmschina.com") >= 0 || index(h, "newone.com.cn") >= 0 || index(h, "sseinfo.com") >= 0 ||
	    index(h, "yundzh.com") >= 0 || index(h, "cninfo.com.cn") >= 0 || index(h, "futunn.com") >= 0 ||
	    substr(h, 0, 12) == "114.141.177." || substr(h, 0, 11) == "210.21.237." ||
	    h == "120.79.73.168" || substr(h, 0, 9) == "14.21.47." || substr(h, 0, 11) == "10.254.247." ||
	    port == 22016 || port == 22017 || port == 7731 || port == 7706 || port == 7717) {
		return "cmschina";
	}

	// 12. Huawei Cloud & HMS Mobile Services
	if (index(h, "dbankcloud.cn") >= 0 || index(h, "dbankcloud.com") >= 0 || index(h, "dbankcdn.com") >= 0 ||
	    index(h, "dbankcdn.cn") >= 0 || index(h, "hicloud.com") >= 0 || index(h, "huawei.com") >= 0 ||
	    index(h, "vmall.com") >= 0 || index(h, "hihonor.com") >= 0 || index(h, "droiyou.com") >= 0 ||
	    index(h, "chujingapp.com") >= 0 || index(h, "zztfly.com") >= 0 ||
	    index(app, "huawei") >= 0 || substr(h, 0, 8) == "49.4.18." || substr(h, 0, 7) == "124.70.") {
		return "huawei";
	}

	// 13. GitHub & Developer CDNs
	if (index(h, "github.com") >= 0 || index(h, "githubusercontent.com") >= 0 || index(h, "jsdelivr.net") >= 0 ||
	    index(h, "unpkg.com") >= 0 || index(h, "sentry.io") >= 0 || index(h, "ksyuncdn.com") >= 0 ||
	    index(h, "npmjs.org") >= 0 || index(h, "opencollective.com") >= 0 || index(h, "metacubex.one") >= 0 ||
	    index(h, "qtlcdn.com") >= 0 || index(h, "defined.net") >= 0 || index(app, "github") >= 0) {
		return "github";
	}

	// 14. X / Twitter
	if (h == "x.com" || index(h, ".x.com") >= 0 || index(h, "twitter.com") >= 0 || index(h, "twimg.com") >= 0) {
		return "twitter";
	}

	// 15. Check learned IP/Subnet24 cache from passive DNS / mihomo / TLS Cert
	if (ip_to_domain[h]) {
		return classify_host(ip_to_domain[h], dpi_app, dst_port);
	}
	let s24 = get_subnet24(h);
	if (s24 != "" && subnet24_to_group[s24]) {
		return subnet24_to_group[s24].group_id;
	}

	return "unknown";
}

function get_provider_hint(host, dst_port) {
	let h = lc(host || "");
	let port = int(dst_port || 0);
	if (substr(h, 0, 12) == "114.141.177." || port == 22016 || port == 22017) return "招商证券一户通 · 行情推送专线 (TCP 22016/22017)";
	if (substr(h, 0, 11) == "210.21.237." || port == 7731) return "招商证券一户通 · 交易/行情节点 (TCP 7731)";
	if (h == "120.79.73.168" || port == 7706) return "招商证券一户通 · 阿里云行情节点 (TCP 7706)";
	if (substr(h, 0, 11) == "10.254.247.") return "招商证券 · 内网服务专线";
	if (substr(h, 0, 9) == "14.21.47.") return "招商证券 · 深圳电信节点";
	if (substr(h, 0, 11) == "119.147.19." || substr(h, 0, 8) == "157.148." || substr(h, 0, 7) == "183.60.") return "Tencent WeChat 直连长连接节点";
	if (substr(h, 0, 7) == "20.213.") return "Microsoft Azure · WebRTC/STUN 实时流 (UDP 3478)";
	if (substr(h, 0, 12) == "162.159.200.") return "Cloudflare NTP 时间同步服务";
	if (substr(h, 0, 8) == "49.4.18." || substr(h, 0, 7) == "124.70.") return "Huawei Cloud · HMS 移动推送节点";
	if (index(h, "myqcloud.com") >= 0 || index(h, "qcloud.com") >= 0 || index(h, "gtimg.com") >= 0) return "Tencent cloud cdn";
	if (index(h, "weixin.qq.com") >= 0 || index(h, "weixin.com") >= 0 || index(h, "wechat.com") >= 0 || index(h, "qpic.cn") >= 0 || index(h, "qlogo.cn") >= 0) return "Tencent WeChat / 微信服务";
	if (index(h, "qq.com") >= 0 || index(h, "tencent.com") >= 0) return "Tencent QQ / 腾讯网";
	if (index(h, "sogou.com") >= 0 || index(h, "sogo.com") >= 0) return "Sogou 搜狗输入法 / 搜索";
	if (index(h, "jd.com") >= 0 || index(h, "360buyimg.com") >= 0) return "JD.com 京东商城 / 静态资源 CDN";
	if (index(h, "aliyuncs.com") >= 0 || index(h, "alicdn.com") >= 0 || index(h, "alibaba.com") >= 0 || index(h, "mmstat.com") >= 0 || index(h, "dingtalk.com") >= 0 || index(h, "quark.cn") >= 0) return "Alibaba Cloud / 阿里生态";
	if (index(h, "googleapis.com") >= 0 || index(h, "google.com") >= 0 || index(h, "gstatic.com") >= 0) return "Google Cloud / APIs";
	if (index(h, "chatgpt.com") >= 0 || index(h, "openai.com") >= 0 || index(h, "openrouter.ai") >= 0 || index(h, "deepseek.com") >= 0 || index(h, "grok.com") >= 0 || index(h, "opencode.ai") >= 0) return "AI 大模型与编程助手服务";
	if (index(h, "apple.com") >= 0 || index(h, "icloud.com") >= 0) return "Apple iCloud / Push";
	if (index(h, "cloudflare.com") >= 0) return "Cloudflare Edge";
	if (index(h, "dbankcloud") >= 0 || index(h, "dbankcdn") >= 0 || index(h, "hicloud.com") >= 0) return "Huawei Cloud 终端与遥测服务";
	if (index(h, "cmschina.com") >= 0 || index(h, "newone.com.cn") >= 0 || index(h, "sseinfo.com") >= 0 || index(h, "yundzh.com") >= 0) return "招商证券 / 金融行情服务";
	if (index(h, "feishu.cn") >= 0 || index(h, "larksuite.com") >= 0 || index(h, "bytedance.com") >= 0 || index(h, "doubao.com") >= 0) return "ByteDance 飞书 / 豆包 / 字节服务";
	return "Direct / Unknown ASN";
}

// Compute heuristic tags and explanations for a host entry
function evaluate_host_heuristics(h_entry) {
	let h = lc(h_entry.host || "");
	let tags = [];
	let notes = [];
	let suspicious_score = 0;
	let suspicious_reasons = [];

	// 1. Shared cloud storage detection
	if (index(h, ".cos.") >= 0 || index(h, ".myqcloud.com") >= 0 || index(h, ".aliyuncs.com") >= 0 ||
	    index(h, ".s3.") >= 0 || index(h, "amazonaws.com") >= 0 || index(h, "r2.cloudflarestorage.com") >= 0) {
		push(tags, { text: "共用云存储", type: "neutral" });
		let bucket = split(h, ".")[0] || h;
		if (index(h, "myqcloud.com") >= 0) {
			push(notes, "腾讯云对象存储 (COS)：很多公司共用的主机名。从名字只能知道是哪家的存储服务，不知道数据是谁的。桶名“" + bucket + "”只能当作线索。");
		} else if (index(h, "aliyuncs.com") >= 0) {
			push(notes, "阿里云对象存储 (OSS)：很多公司共用的云存储桶。桶名“" + bucket + "”可作为判断归属应用的线索。");
		} else {
			push(notes, "公有云对象存储服务：多个应用可能共用此类存储域名，子域名前缀“" + bucket + "”是识别归属的主要线索。");
		}
	}

	// 2. Input method / keyboard naming heuristics
	if (index(h, "wxkb") >= 0 || substr(h, 0, 4) == "ime." || index(h, ".ime.") >= 0 || index(h, "-ime") >= 0 || index(h, "input") >= 0 || index(h, "sogou") >= 0 || index(h, "iflytek") >= 0) {
		push(tags, { text: "名字像输入法", type: "warn" });
		suspicious_score += 40;
		push(suspicious_reasons, "名字像输入法");
		if (index(h, "wxkb") >= 0) {
			push(notes, "名字里有“wxkb”，看起来像微信输入法 (WeChat Keyboard) 或键盘相关的云端服务。这只是根据名字猜的。");
		} else {
			push(notes, "域名中包含输入法相关特征词，可能涉及输入法词库同步、语音识别或剪贴板/遥测上传。");
		}
	}

	// 3. Unencrypted traffic detection
	if (h_entry. encrypted === false) {
		push(tags, { text: "未加密", type: "warn" });
		suspicious_score += 35;
		push(suspicious_reasons, "存在未加密明文传输");
		push(notes, "检测到未使用 TLS/HTTPS 的明文连接（端口或协议未加密），传输内容可能被网络中间节点窥探。");
	}

	// 4. Telemetry / logging heuristics
	if (index(h, "metrics") >= 0 || index(h, "telemetry") >= 0 || index(h, "beacon") >= 0 || index(h, "collect") >= 0 ||
	    index(h, "nel.") >= 0 || index(h, "stat") >= 0 || index(h, "log") >= 0 || index(h, "user-data") >= 0) {
		push(tags, { text: "遥测或日志", type: "info" });
		suspicious_score += 15;
		push(notes, "域名特征包含遥测/指标上报关键词（如 metrics/user-data/nel），通常用于后台收集设备诊断或行为数据。");
	}

	// 5. Large single-connection upload or high upload volume
	if ((h_entry.max_single_up || 0) >= 5 * 1024 * 1024 || (h_entry.up || 0) >= 10 * 1024 * 1024) {
		suspicious_score += 50;
		push(suspicious_reasons, "大额单次上传");
	} else if ((h_entry.up || 0) >= 1024 * 1024 && (h_entry.up || 0) > (h_entry.down || 1) * 3) {
		suspicious_score += 30;
		push(suspicious_reasons, "上传显著高于下载");
	}

	// 6. Night-time upload
	if ((h_entry.night_up || 0) >= 100 * 1024) {
		suspicious_score += 25;
		push(suspicious_reasons, "存在夜间上传");
	}

	if (length(notes) == 0) {
		push(notes, "路由器上的名单里没有这个网站的特殊风险说明。可通过连接频次、单次最大上传量和夜间活跃度判断其行为是否符合预期。");
	} else {
		unshift(notes, "路由器上的名单里没有这个网站的说明。");
	}

	return {
		tags,
		notes,
		suspicious_score,
		suspicious_reasons
	};
}

// Record a connection sample into history
function record_flow_sample(src_ip, host, dst_ip, dst_port, proto, delta_up, delta_down, total_conn_up, is_new_conn, encrypted, dpi_app, dpi_proto, device_total_bps) {
	if (!host || host == "") host = dst_ip || "unknown";
	// Ignore local router accesses and outer proxy relay server IPs (inner connections are already tracked with real domains)
	if (substr(host, 0, length(LAN_PREFIX)) == LAN_PREFIX || host == "127.0.0.1" || substr(host, 0, 8) == "198.18.0" || substr(host, 0, 8) == "172.254." || proxy_server_ips[host]) return;

	let now = time();
	let dp = get_date_parts(now);
	if (history.today_date != dp.date_str) {
		history.today_date = dp.date_str;
		history.today_up = 0;
		history.today_down = 0;
	}
	history.today_up += delta_up;
	history.today_down += delta_down;

	let h_entry = history.hosts[host];
	if (!h_entry) {
		let gid = classify_host(host, dpi_app, dst_port);
		h_entry = {
			host: host,
			group_id: gid,
			provider: get_provider_hint(host, dst_port),
			up: 0,
			down: 0,
			conn_count: 0,
			max_single_up: 0,
			night_up: 0,
			idle_up: 0,
			encrypted: (encrypted !== false),
			dpi_app: dpi_app || "",
			dpi_proto: dpi_proto || (dst_port == 443 ? "TLS" : (dst_port == 80 ? "HTTP" : proto)),
			first_seen: now,
			last_seen: now,
			active_hours: {},
			big_hours: {},
			devices: {}
		};
		history.hosts[host] = h_entry;
	}

	h_entry.up += delta_up;
	h_entry.down += delta_down;
	h_entry.last_seen = now;
	if (is_new_conn) h_entry.conn_count += 1;
	if (total_conn_up > (h_entry.max_single_up || 0)) {
		h_entry.max_single_up = total_conn_up;
	}
	if (encrypted === false) {
		h_entry.encrypted = false;
	}
	if (dpi_app && dpi_app != "Unknown" && !h_entry.dpi_app) {
		h_entry.dpi_app = dpi_app;
		h_entry.group_id = classify_host(host, dpi_app);
	}
	if (dpi_proto && dpi_proto != "Unknown") {
		h_entry.dpi_proto = dpi_proto;
	}

	if (dp.is_night && delta_up > 0) {
		h_entry.night_up = (h_entry.night_up || 0) + delta_up;
	}
	// If device overall interactive traffic is very low (< 5 KB/s) or night time, count as idle upload
	if (delta_up > 0 && (dp.is_night || (device_total_bps || 0) < 5120)) {
		h_entry.idle_up = (h_entry.idle_up || 0) + delta_up;
	}

	// Track active hour
	if (delta_up > 0 || delta_down > 0 || is_new_conn) {
		let ah = h_entry.active_hours[dp.hour_str];
		if (!ah) {
			ah = { up: 0, down: 0, max_up: 0 };
			h_entry.active_hours[dp.hour_str] = ah;
		}
		ah.up += delta_up;
		ah.down += delta_down;
		if (total_conn_up > ah.max_up) ah.max_up = total_conn_up;
		if (total_conn_up >= 1024 * 1024) {
			h_entry.big_hours[dp.hour_str] = ah.up;
		}
	}

	// Track per-device stats for this host
	let dev_entry = h_entry.devices[src_ip];
	if (!dev_entry) {
		dev_entry = { ip: src_ip, up: 0, down: 0, conn_count: 0, max_single_up: 0, night_up: 0, idle_up: 0, last_seen: now };
		h_entry.devices[src_ip] = dev_entry;
	}
	dev_entry.up += delta_up;
	dev_entry.down += delta_down;
	dev_entry.last_seen = now;
	if (is_new_conn) dev_entry.conn_count += 1;
	if (total_conn_up > dev_entry.max_single_up) dev_entry.max_single_up = total_conn_up;
	if (dp.is_night && delta_up > 0) dev_entry.night_up += delta_up;
}

// Parse netifyd JSON line
function handle_netify_line(line) {
	if (!line || length(line) < 2 || substr(line, 0, 1) != "{") return;
	let msg = null;
	try {
		msg = json(line);
	} catch (e) {
		return;
	}
	if (!msg || !msg.type) return;

	if (msg.type == "agent_status") {
		netify_flow_count = msg.flow_count || 0;
		return;
	}
	if (msg.type == "flow" && msg.flow) {
		let f = msg.flow;
		let host = f.host_server_name || (f.ssl && f.ssl.client_sni) || (f.http && f.http.host) || (f.dns && f.dns.query_hostname) || "";
		if (host == "" && f.ssl && f.ssl.subject_dn) {
			let m_cn = match(f.ssl.subject_dn, /CN=\*?\.?([a-zA-Z0-9._-]+\.[a-zA-Z]+)/);
			if (m_cn) host = m_cn[1];
		}
		let proto_name = f.detected_protocol_name || "";
		let app_name = f.detected_application_name || "";
		let local_ip = f.local_ip || "";
		let other_ip = f.other_ip || "";
		let local_port = f.local_port || 0;
		let other_port = f.other_port || 0;

		let src_ip = "";
		let dst_ip = "";
		let src_port = 0;
		let dst_port = 0;
		if (substr(local_ip, 0, 10) == "192.168.8." && local_ip != "192.168.8.1") {
			src_ip = local_ip; src_port = local_port;
			dst_ip = other_ip; dst_port = other_port;
		} else if (substr(other_ip, 0, 10) == "192.168.8." && other_ip != "192.168.8.1") {
			src_ip = other_ip; src_port = other_port;
			dst_ip = local_ip; dst_port = local_port;
		} else {
			return;
		}

		// Determine if encrypted
		let encrypted = true;
		let up_proto = uc(proto_name);
		if (up_proto == "HTTP" || up_proto == "MQTT" || dst_port == 80 || dst_port == 8080 || (dst_port != 443 && dst_port != 123 && dst_port != 53 && up_proto != "TLS" && up_proto != "QUIC" && up_proto != "HTTPS" && up_proto != "SSH" && up_proto != "DNS" && up_proto != "NTP" && !f.ssl)) {
			encrypted = false;
		}

		let info = {
			host: host,
			app: app_name,
			proto: proto_name,
			encrypted: encrypted,
			dst_ip: dst_ip,
			dst_port: dst_port,
			ts: time()
		};
		dpi_flows[src_ip + ":" + src_port] = info;
		if (host != "" && substr(dst_ip, 0, 7) != "198.18.") {
			dpi_flows[dst_ip + ":" + dst_port] = info;
			learn_ip_domain(dst_ip, host, classify_host(host, app_name, dst_port));
		}
		if (host != "") {
			dpi_flows["host:" + lc(host)] = info;
		}
	}
}

// Maintain non-blocking connection to netifyd socket
let netify_sock = null;
let netify_handle = null;
let netify_buf = "";

function connect_netify() {
	if (netify_sock) return;
	let s = socket.connect(NETIFY_SOCK);
	if (!s) {
		netify_connected = false;
		return;
	}
	netify_sock = s;
	netify_connected = true;
	netify_buf = "";
	netify_handle = uloop.handle(s, function(flags) {
		let chunk = netify_sock.recv(32768);
		if (!chunk || length(chunk) == 0) {
			if (netify_handle) netify_handle.delete();
			netify_handle = null;
			netify_sock.close();
			netify_sock = null;
			netify_connected = false;
			return;
		}
		netify_buf += chunk;
		let lines = split(netify_buf, "\n");
		netify_buf = pop(lines);
		for (let line in lines) {
			handle_netify_line(trim(line));
		}
	}, uloop.ULOOP_READ);
}

// Fetch mihomo connections via local socket
function fetch_mihomo_connections() {
	let s = socket.connect("127.0.0.1", 9090);
	if (!s) return [];
	s.send("GET /connections HTTP/1.0\r\nHost: 127.0.0.1:9090\r\nConnection: close\r\n\r\n");
	let resp = "";
	while (true) {
		let c = s.recv(65536);
		if (!c || length(c) == 0) break;
		resp += c;
	}
	s.close();
	let idx = index(resp, "\r\n\r\n");
	if (idx < 0) return [];
	let parsed = null;
	try {
		parsed = json(substr(resp, idx + 4));
	} catch (e) {
		parsed = null;
	}
	return (parsed && type(parsed.connections) == "array") ? parsed.connections : [];
}

// Poll conntrack for direct flows that bypass mihomo
function fetch_conntrack_direct(mihomo_ports) {
	let raw = fs.readfile("/proc/net/nf_conntrack");
	if (!raw) return [];
	let list = [];
	for (let line in split(raw, "\n")) {
		if (index(line, "src=192.168.8.") < 0) continue;
		let m_src = match(line, /src=(192\.168\.8\.[0-9]+) dst=([0-9.]+) sport=([0-9]+) dport=([0-9]+) packets=[0-9]+ bytes=([0-9]+) .* src=[0-9.]+ dst=[0-9.]+ sport=[0-9]+ dport=[0-9]+ packets=[0-9]+ bytes=([0-9]+)/);
		if (!m_src) continue;
		let src_ip = m_src[1];
		let dst_ip = m_src[2];
		let sport = int(m_src[3]);
		let dport = int(m_src[4]);
		let up_bytes = int(m_src[5]);
		let down_bytes = int(m_src[6]);

		if (src_ip == ROUTER_IP || dst_ip == ROUTER_IP || substr(dst_ip, 0, 7) == "198.18." || proxy_server_ips[dst_ip]) continue;
		if (mihomo_ports[src_ip + ":" + sport]) continue;

		let proto = (index(line, "tcp") >= 0) ? "tcp" : "udp";
		let dpi = dpi_flows[src_ip + ":" + sport] || dpi_flows[dst_ip + ":" + dport];
		let host = (dpi && dpi.host != "") ? dpi.host : dst_ip;
		let encrypted = dpi ? dpi.encrypted : (dport == 443 || dport == 22 || dport == 853);
		push(list, {
			id: "ct:" + proto + ":" + src_ip + ":" + sport + ":" + dst_ip + ":" + dport,
			src_ip: src_ip,
			src_port: sport,
			dst_host: host,
			dst_ip: dst_ip,
			dst_port: dport,
			proto: proto,
			up: up_bytes,
			down: down_bytes,
			encrypted: encrypted,
			dpi_app: dpi ? dpi.app : "",
			dpi_proto: dpi ? dpi.proto : uc(proto),
			rule: "DIRECT"
		});
	}
	return list;
}

let last_tick_ms = 0;
let save_counter = 0;

function now_ms() {
	let tv = uloop.interval ? time() * 1000 : time() * 1000;
	return tv;
}

// Main 2-second sampling loop
function sample_traffic() {
	connect_netify();
	refresh_devices();

	let now = time();
	let dt = (last_tick_ms > 0 && (now - last_tick_ms) > 0) ? (now - last_tick_ms) : 2;
	last_tick_ms = now;

	let mh_conns = fetch_mihomo_connections();
	let mihomo_ports = {};
	let current_conns = {};
	let live_conns_list = [];

	// Normalize mihomo connections
	for (let c in mh_conns) {
		let md = c.metadata || {};
		let src_ip = md.sourceIP || "";
		if (!get_device_info(src_ip)) continue;

		let sport = int(md.sourcePort || 0);
		let dport = int(md.destinationPort || 0);
		mihomo_ports[src_ip + ":" + sport] = true;

		let host = md.sniffHost || md.host || md.destinationIP || md.remoteDestination || "unknown";
		let dst_ip = md.remoteDestination || md.destinationIP || "";
		let dpi = dpi_flows[src_ip + ":" + sport] || dpi_flows["host:" + lc(host)];
		if ((host == "" || host == "unknown" || substr(host, 0, 7) == "198.18.") && dpi && dpi.host) {
			host = dpi.host;
		}
		if (dst_ip != "" && host != "" && host != dst_ip) {
			learn_ip_domain(dst_ip, host, classify_host(host, dpi ? dpi.app : "", dport));
		} else if (host == dst_ip && ip_to_domain[dst_ip]) {
			host = ip_to_domain[dst_ip];
		}
		let encrypted = true;
		if (dport == 80 || dport == 8080 || (dport != 123 && dport != 53 && dpi && dpi.encrypted === false)) {
			encrypted = false;
		}

		let cid = "mh:" + c.id;
		current_conns[cid] = {
			id: cid,
			src_ip: src_ip,
			src_port: sport,
			dst_host: host,
			dst_ip: dst_ip,
			dst_port: dport,
			proto: md.network || "tcp",
			up: int(c.upload || 0),
			down: int(c.download || 0),
			encrypted: encrypted,
			dpi_app: dpi ? dpi.app : "",
			dpi_proto: dpi ? dpi.proto : (dport == 443 ? "TLS" : uc(md.network || "TCP")),
			chain: (type(c.chains) == "array" && length(c.chains) > 0) ? c.chains[0] : "DIRECT",
			start: c.start || ""
		};
	}

	// Add direct conntrack connections
	let ct_conns = fetch_conntrack_direct(mihomo_ports);
	for (let c in ct_conns) {
		if (!get_device_info(c.src_ip)) continue;
		current_conns[c.id] = c;
	}

	// First pass: compute per-device live speeds
	let dev_stats = {};
	for (let ip, d in dhcp_devices) {
		dev_stats[ip] = {
			ip: ip,
			name: d.name,
			mac: d.mac,
			icon: d.icon,
			up_bps: 0,
			down_bps: 0,
			conn_count: 0,
			active: false
		};
	}

	let conn_deltas = {};
	for (let cid, c in current_conns) {
		let prev = prev_conns[cid];
		let is_new = !prev;
		let dup = 0;
		let ddown = 0;
		if (prev) {
			dup = (c.up >= prev.up) ? (c.up - prev.up) : c.up;
			ddown = (c.down >= prev.down) ? (c.down - prev.down) : c.down;
		} else {
			dup = c.up;
			ddown = c.down;
		}
		let up_bps = int(dup / dt);
		let down_bps = int(ddown / dt);
		conn_deltas[cid] = { dup, ddown, up_bps, down_bps, is_new };

		let dinfo = get_device_info(c.src_ip);
		if (dinfo) {
			if (!dev_stats[c.src_ip]) {
				dev_stats[c.src_ip] = { ip: c.src_ip, name: dinfo.name, mac: dinfo.mac, icon: dinfo.icon, up_bps: 0, down_bps: 0, conn_count: 0, active: false };
			}
			dev_stats[c.src_ip].up_bps += up_bps;
			dev_stats[c.src_ip].down_bps += down_bps;
			dev_stats[c.src_ip].conn_count += 1;
			if (up_bps > 0 || down_bps > 0) dev_stats[c.src_ip].active = true;
		}
	}

	// Second pass: record into history & build live group stats
	let live_groups = {};
	let router_up_bps = 0;
	let router_down_bps = 0;

	for (let cid, c in current_conns) {
		let delta = conn_deltas[cid];
		let dev_bps = dev_stats[c.src_ip] ? (dev_stats[c.src_ip].up_bps + dev_stats[c.src_ip].down_bps) : 0;

		record_flow_sample(
			c.src_ip, c.dst_host, c.dst_ip, c.dst_port, c.proto,
			delta.dup, delta.ddown, c.up, delta.is_new,
			c.encrypted, c.dpi_app, c.dpi_proto, dev_bps
		);

		router_up_bps += delta.up_bps;
		router_down_bps += delta.down_bps;

		let gid = classify_host(c.dst_host, c.dpi_app, c.dst_port);
		let gmeta = SERVICE_GROUPS[gid] || SERVICE_GROUPS["unknown"];
		if (!live_groups[gid]) {
			live_groups[gid] = {
				id: gid,
				name: gmeta.name,
				badge: gmeta.badge,
				order: gmeta.order,
				up_bps: 0,
				down_bps: 0,
				conn_count: 0,
				devices_map: {},
				unencrypted: false,
				suspicious: false,
				warning_badge: ""
			};
		}
		let lg = live_groups[gid];
		lg.up_bps += delta.up_bps;
		lg.down_bps += delta.down_bps;
		lg.conn_count += 1;
		lg.devices_map[c.src_ip] = true;
		if (!c.encrypted) {
			lg.unencrypted = true;
			lg.warning_badge = "未加密";
		}

		let dinfo = get_device_info(c.src_ip);
		push(live_conns_list, {
			id: cid,
			device_ip: c.src_ip,
			device_name: dinfo ? dinfo.name : c.src_ip,
			host: c.dst_host,
			dst_ip: c.dst_ip,
			dst_port: c.dst_port,
			proto: c.dpi_proto || uc(c.proto),
			group_id: gid,
			group_name: gmeta.name,
			up_bps: delta.up_bps,
			down_bps: delta.down_bps,
			total_up: c.up,
			total_down: c.down,
			encrypted: c.encrypted,
			chain: c.chain || "DIRECT"
		});
	}

	prev_conns = current_conns;

	// Also merge historical groups so destinations seen earlier today appear in the topology (even if currently idle)
	let alerts = [];
	let alert_groups_seen = {};
	for (let hname, hentry in history.hosts) {
		if (proxy_server_ips[hname] || substr(hname, 0, 8) == "172.254.") {
			delete history.hosts[hname];
			continue;
		}
		let gid = classify_host(hname, hentry.dpi_app, 0);
		hentry.group_id = gid;
		hentry.provider = get_provider_hint(hname, 0);
		let gmeta = SERVICE_GROUPS[gid] || SERVICE_GROUPS["unknown"];
		if (!live_groups[gid]) {
			live_groups[gid] = {
				id: gid,
				name: gmeta.name,
				badge: gmeta.badge,
				order: gmeta.order,
				up_bps: 0,
				down_bps: 0,
				conn_count: 0,
				devices_map: {},
				unencrypted: false,
				suspicious: false,
				warning_badge: ""
			};
		}
		let lg = live_groups[gid];
		let heur = evaluate_host_heuristics(hentry);
		if (hentry.encrypted === false) {
			lg.unencrypted = true;
			if (!lg.warning_badge) lg.warning_badge = "未加密";
		}
		if (heur.suspicious_score >= 35) {
			lg.suspicious = true;
			if (!lg.warning_badge && length(heur.tags) > 0) {
				lg.warning_badge = heur.tags[0].text;
			}
			if (!alert_groups_seen[gid]) {
				alert_groups_seen[gid] = true;
				push(alerts, {
					group_id: gid,
					group_name: gmeta.name,
					host: hname,
					score: heur.suspicious_score,
					reasons: heur.suspicious_reasons,
					max_single_up: hentry.max_single_up,
					up: hentry.up
				});
			}
		}
	}

	// Format devices array sorted by active speed then historical traffic
	let devices_arr = [];
	let active_dev_count = 0;
	for (let ip, ds in dev_stats) {
		// Check if device has any connections or history
		let has_hist = false;
		for (let hname, hentry in history.hosts) {
			if (hentry.devices && hentry.devices[ip]) {
				has_hist = true;
				break;
			}
		}
		if (ds.conn_count == 0 && !has_hist && ip != "192.168.8.245" && ip != "192.168.8.208") continue;
		if (ds.up_bps > 0 || ds.down_bps > 0) active_dev_count += 1;
		push(devices_arr, ds);
	}
	sort(devices_arr, function(a, b) {
		return ((b.up_bps + b.down_bps) - (a.up_bps + a.down_bps)) || (b.conn_count - a.conn_count);
	});

	// Format groups array sorted by active speed then order
	let groups_arr = [];
	let active_group_count = 0;
	for (let gid, lg in live_groups) {
		let dev_list = keys(lg.devices_map);
		delete lg.devices_map;
		lg.device_count = length(dev_list);
		lg.devices = dev_list;
		if (lg.up_bps > 0 || lg.down_bps > 0) active_group_count += 1;
		push(groups_arr, lg);
	}
	sort(groups_arr, function(a, b) {
		let a_act = (a.up_bps + a.down_bps > 0) ? 1 : 0;
		let b_act = (b.up_bps + b.down_bps > 0) ? 1 : 0;
		if (a_act != b_act) return b_act - a_act;
		if ((b.up_bps + b.down_bps) != (a.up_bps + a.down_bps)) return (b.up_bps + b.down_bps) - (a.up_bps + a.down_bps);
		return a.order - b.order;
	});

	// Sort live connections by speed + total upload
	sort(live_conns_list, function(a, b) {
		return ((b.up_bps + b.down_bps) - (a.up_bps + a.down_bps)) || (b.total_up - a.total_up);
	});

	sort(alerts, function(a, b) {
		return b.score - a.score;
	});

	let live_payload = {
		version: VERSION,
		ui_version: VERSION + "-1",
		timestamp: now,
		netify_connected: netify_connected,
		netify_flows: netify_flow_count,
		router: {
			up_bps: router_up_bps,
			down_bps: router_down_bps,
			active_devices: active_dev_count,
			total_devices: length(devices_arr),
			active_groups: active_group_count,
			total_groups: length(groups_arr),
			today_up: history.today_up,
			today_down: history.today_down,
			total_connections: length(live_conns_list),
			status_text: "实时数据正常"
		},
		alerts: alerts,
		devices: devices_arr,
		groups: groups_arr,
		connections: slice(live_conns_list, 0, 150)
	};

	save_json_file(LIVE_FILE, live_payload);

	// Cleanup stale DPI cache every minute & persist history
	save_counter += 1;
	if (save_counter % 5 == 0) {
		save_json_file(HIST_TMP_FILE, history);
	}
	if (save_counter >= 60) {
		save_counter = 0;
		for (let k, v in dpi_flows) {
			if (now - v.ts > 300) delete dpi_flows[k];
		}
		save_json_file(HIST_ETC_FILE, history);
	}
}

// Seed initial history from current mihomo active connections on startup
uloop.init();
sample_traffic();
save_json_file(HIST_TMP_FILE, history);

let timer = null;
function tick() {
	sample_traffic();
	timer.set(2000);
}
timer = uloop.timer(2000, tick);

uloop.run();
